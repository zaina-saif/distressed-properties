DATABASE_URL=postgresql+psycopg2://postgres:password@supabase-host:5432/postgres
# Self-hosted PostgreSQL for public history and AVM training data. If omitted,
# warehouse pipelines use DATABASE_URL for backward compatibility.
WAREHOUSE_DATABASE_URL=postgresql+psycopg2://LOCAL_USER@localhost:5432/sheriff_sale_warehouse
# Pipeline scripts refuse that fallback unless this is set to 1.
# ALLOW_WAREHOUSE_FALLBACK=1
REALIE_API_KEY=

# Optional independent provider link shown after the preliminary lien analysis.
# No property data is sent to this provider by the application.
TITLE_SEARCH_PROVIDER_NAME=ProTitleUSA
TITLE_SEARCH_PROVIDER_URL=https://www.protitleusa.com/

# Optional municipality/county public APIs. Keys may be DEFAULT, STATE:COUNTY,
# STATE:CITY, county, or city. Do not add credentials or private endpoints here.
SODA_ENDPOINTS_JSON={}
ARCGIS_TAX_ENDPOINTS_JSON={}

# Optional. Google Maps Platform key with the Street View Static API enabled.
# Used server-side for property photos when Zillow has no listing photo.
GOOGLE_MAPS_API_KEY=

# Apify token for Zillow lookups (pipelines only; the API does not use it).
APIFY_API_TOKEN=

# Production API settings. Comma-separated browser origins allowed to call the
# API (defaults to http://localhost:3000), plus an optional regex for preview
# deployments such as https://.*-your-team\.vercel\.app
# CORS_ALLOWED_ORIGINS=https://www.example.com,https://example.com
# CORS_ALLOWED_ORIGIN_REGEX=
# Set to 0 on hosts that cannot reach the self-hosted warehouse database.
# ENABLE_WAREHOUSE_API=0

# Sign-in: the API verifies Supabase access tokens against this project's public keys.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Publishable key (same as the frontend's). Lets the API confirm sessions with
# Supabase Auth when a token is not signed with a published key (legacy secret).
SUPABASE_ANON_KEY=
# Secret key ("sb_secret_...", or the legacy service_role key), only for
# `python -m app.create_developer` on a trusted machine. Never deploy it
# to the frontend; the API itself does not need it.
# SUPABASE_SERVICE_ROLE_KEY=

# Billing (Stripe). Prices are recurring prices created in the Stripe dashboard.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTH=
STRIPE_PRICE_STARTER_YEAR=
STRIPE_PRICE_PRO_MONTH=
STRIPE_PRICE_PRO_YEAR=
# Where Stripe Checkout and the billing portal send people back to.
FRONTEND_URL=http://localhost:3000
