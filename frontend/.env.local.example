NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# Optional. Enables Geoapify basemap tiles and place search. Restrict this browser key by domain.
NEXT_PUBLIC_GEOAPIFY_API_KEY=
# Supabase sign-in: Project Settings → API Keys. Use the publishable key
# ("sb_publishable_...", or the legacy anon key) only,
# never the service-role key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
